{
  "name": "flooroo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4406 --strictPort",
    "build": "vite build",
    "build:pages": "vite build --base=/flooroo/",
    "preview": "vite preview --host 127.0.0.1 --port 4406 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:editor": "node tests/editor-browser.mjs",
    "test:versions": "node tests/versions-browser.mjs",
    "test:workspace": "node tests/workspace-browser.mjs",
    "test:theme": "node tests/theme-browser.mjs",
    "test:dimensions": "node tests/dimensions-browser.mjs",
    "test:blocks": "node tests/block-catalog-browser.mjs",
    "test:pages": "node tests/pages-browser.mjs",
    "test:images": "node tests/reference-browser.mjs",
    "test:palette": "node tests/palette-order-browser.mjs"
  },
  "dependencies": {
    "lucide": "0.462.0",
    "nbtify": "2.1.0",
    "quantize": "1.0.2",
    "three": "0.156.1"
  },
  "devDependencies": {
    "playwright": "1.59.1",
    "vite": "6.4.6"
  }
}
